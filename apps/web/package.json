{
  "name": "@sendtally/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy:staging": "CLOUDFLARE_ENV=staging react-router build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production react-router build && wrangler deploy",
    "check-types": "react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sendtally/design": "workspace:*",
    "isbot": "^5.1.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.3",
    "@cloudflare/workers-types": "^4.20250823.0",
    "@react-router/dev": "^7.8.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.33.1"
  }
}
