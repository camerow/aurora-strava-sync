{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendtally-web",
  "main": "workers/app.ts",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.sendtally.com", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api-staging.sendtally.com",
        "CLERK_PUBLISHABLE_KEY": "pk_test_bGlnaHQtbGlnZXItOTkuY2xlcmsuYWNjb3VudHMuZGV2JA",
      },
    },
    "production": {
      "routes": [{ "pattern": "sendtally.com", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api.sendtally.com",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2VuZHRhbGx5LmNvbSQ",
      },
    },
  },
}
