{
  "name": "boardsync",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "format": "turbo format --continue -- && prettier --write \"*.{md,json,yaml,yml}\" \"docs/**/*.md\"",
    "format:check": "turbo format:check --continue -- && prettier --check \"*.{md,json,yaml,yml}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
